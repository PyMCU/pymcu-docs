# Expose Astro dependencies for `pnpm` users
shamefully-hoist=true

# The site is on Astro 6; @astrojs/tailwind still declares a peer of
# astro ^3 || ^4 || ^5 and its latest release (6.0.2) has not moved. Without
# this, a plain `npm ci` fails to resolve the tree at all.
#
# It lives here rather than as a flag in CI because every installer has to
# agree: Cloudflare Workers Builds runs its own `npm clean-install` before it
# ever reaches the build command, so a flag in the build command comes too
# late. A file in the repo covers Cloudflare, GitHub Actions and laptops alike.
#
# Remove this once the site moves to Tailwind 4 with @tailwindcss/vite.
legacy-peer-deps=true
